# tauka-python — copy to .env and fill in. Never commit the real .env.

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=                       # https://<ref>.supabase.co
SUPABASE_KEY=                       # service-role key (server-side only)
SUPABASE_ANON_KEY=                  # anon key (RLS-respecting operations)
SUPABASE_JWT_SECRET=                # verifies Supabase-issued JWTs

# ── Redis (optional; rate limiting skipped if unreachable) ─
REDIS_URL=redis://localhost:6379

# ── AI providers ──────────────────────────────────────────
DEEPSEEK_API_KEY=                   # primary AI provider
OPENAI_API_KEY=                     # optional
GEMINI_API_KEY=                     # optional
MODEL_NAME=deepseek-chat
TOKEN_LIMIT=100000

# ── Video calling ─────────────────────────────────────────
DAILY_API_KEY=
LIVEKIT_API_KEY=
LIVEKIT_SECRET=

# ── Stripe (billing + gifts) ──────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_LEARNER_MONTHLY=
STRIPE_PRICE_TUTOR_MONTHLY=
STRIPE_PRICE_INTENSIVE_MONTHLY=
STRIPE_PRICE_GIFT_1MO=
STRIPE_PRICE_GIFT_3MO=

# ── CORS ──────────────────────────────────────────────────
# Comma-separated browser origins allowed to call this API. tauka-react-web is
# always a different origin, so an unlisted origin fails at the preflight.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://tauka.io,https://www.tauka.io,https://www.tauka.com,https://tauka.com

# ── Email ─────────────────────────────────────────────────
# "console" (render to EMAIL_OUTBOX_DIR, no network — use locally),
# "smtp" (any host; defaults target a local Mailpit), or "resend" (production).
# NB: "sendgrid" is named in CLAUDE.md but is not implemented.
EMAIL_PROVIDER=console
EMAIL_API_KEY=                      # Resend API key; required only for EMAIL_PROVIDER=resend
EMAIL_FROM_ADDRESS=Tauka <support@tauka.io>   # for smtp: must be SMTP_USER or a verified alias of it, else 553 at DATA
EMAIL_OUTBOX_DIR=.outbox            # where "console" writes rendered messages
ADMIN_EMAIL=support@tauka.io        # internal recipient for ops notifications; empty disables them

# ── SMTP (only when EMAIL_PROVIDER=smtp) ──────────────────
# Local inbox UI: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
# A real host needs exactly one TLS flag, matched to the port:
#   port 587 → SMTP_STARTTLS=true    (connect plaintext, then upgrade)
#   port 465 → SMTP_SSL=true         (TLS from the first byte)
# Mismatching them makes every send hang until the 15s timeout.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=                          # empty for Mailpit
SMTP_PASSWORD=                      # empty for Mailpit
SMTP_STARTTLS=false
SMTP_SSL=false

# ── URLs ──────────────────────────────────────────────────
# Locally, point these at the Vite dev server so links in mail are clickable.
# Injected as Jinja globals into every email template — every link and the footer
# nav are built from WEB_BASE_URL, so a wrong value ships dead links.
#
# ⚠ DEPLOY: do NOT ship a .env carrying the local values. The defaults in
# config.py are already the production origins, so the safest deploy is to leave
# both UNSET on the host. Shipping the dev .env sends real mail containing
# http://localhost:5173 links — no exception is raised and the send is reported
# as `sent`, so only the recipient ever sees it. The app now logs
# "DEPLOYMENT: ..." at ERROR on startup when a local URL is paired with a mail
# provider that delivers externally; check the boot logs after deploying.
WEB_BASE_URL=https://tauka.io
# This service's own public origin. The unsubscribe and opt-out links in email
# resolve to FastAPI routes here, not to pages on the marketing site.
API_BASE_URL=https://api.tauka.io

# ── Scheduled jobs ────────────────────────────────────────
# Shared secret for GET /tasks/daily, which runs gift lifecycle, milestone
# checks and testimonial outreach. On Vercel, set CRON_SECRET as a project env
# var and Vercel Cron sends it automatically as `Authorization: Bearer <secret>`
# — you do not wire it up anywhere else. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Leaving it EMPTY makes the endpoint refuse every request (503). That is
# deliberate: it can mail every supporter you have, so a missing value must mean
# "nothing runs", never "anyone can run it".
CRON_SECRET=

# Ceiling for post-request work (result emails, referral linkage, usage logging)
# now that it runs inline rather than in BackgroundTasks. Sized for Vercel
# Hobby's ~10s function limit; raise on Pro or a persistent host.
FOLLOWUP_TIMEOUT_SECONDS=6
# Per-send SMTP socket timeout. Must stay below the platform function limit.
SMTP_TIMEOUT_SECONDS=8

# ── Payout encryption ─────────────────────────────────────
ENCRYPTION_KEY=                     # Fernet key for encrypting payout settings
